# Local .terraform directory
.terraform/

# .tfstate files (Contains sensitive data)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all variable files with credentials
*.tfvars
*.tfvars.json

# Exclude specific auto vars if they contain secrets
# secrets.auto.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI Config files
.terraformrc
terraform.rc

